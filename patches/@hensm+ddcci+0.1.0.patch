+Napi::Value
+getCapabilitiesString(const Napi::CallbackInfo& info)
+{
+    Napi::Env env = info.Env();
+
+    if (info.Length() < 1 || !info[0].IsString()) {
+        throw Napi::TypeError::New(env, "Expected monitor device path string");
+    }
+
+    std::string monitorName = info[0].As<Napi::String>().Utf8Value();
+
+    auto it = handles.find(monitorName);
+    if (it == handles.end()) {
+        throw Napi::Error::New(env, "Monitor not found");
+    }
+
+    DWORD capLen = 0;
+    if (!GetCapabilitiesStringLength(it->second, &capLen)) {
+        return env.Null();
+    }
+
+    std::string capStr(capLen, '\0');
+    if (!CapabilitiesRequestAndCapabilitiesReply(it->second, &capStr[0], capLen)) {
+        return env.Null();
+    }
+
+    capStr.erase(std::find(capStr.begin(), capStr.end(), '\0'), capStr.end());
+
+    return Napi::String::New(env, capStr);
+}
