{
  "name": "mission-control",
  "version": "0.1.0",
  "description": "Hardware device management and custom services runner for Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/hardtekpt/control_centre_pro"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.webclient.json --noEmit",
    "build:web": "vite build --config vite.config.web.ts",
    "postinstall": "patch-package && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "electron-updater": "^6.1.7",
    "fft.js": "*",
    "naudiodon2": "*",
    "qrcode.react": "^4.2.0",
    "react-transition-group": "^4.4.5",
    "ws": "^8.20.1"
  },
  "optionalDependencies": {
    "@hensm/ddcci": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "zustand": "^4.5.2"
  }
}
